---
import Base from '../layouts/Base.astro';
import SectionTitle from '../components/SectionTitle.astro';
import pages from '../data/pages.json';
import { withBase } from '../lib.js';

// One page per HTML file in src/content/pages/. Titles live in src/data/pages.json.
const files = import.meta.glob('../content/pages/*.html', { query: '?raw', import: 'default', eager: true });

export function getStaticPaths() {
  const files = import.meta.glob('../content/pages/*.html', { query: '?raw', import: 'default', eager: true });
  return Object.keys(files).map((k) => ({ params: { slug: k.split('/').pop().replace('.html', '') } }));
}

const { slug } = Astro.params;
const html = withBase(files[`../content/pages/${slug}.html`]);
const page = pages[slug] ?? { title: slug };
---
<Base title={page.title} description={page.description} current={slug === 'faq' ? 'FAQ' : ''}>
  <section class="section">
    <div class="container">
      <SectionTitle caption={page.caption} title={page.title} level="h1" />
      <div class="prose" set:html={html} />
    </div>
  </section>
</Base>

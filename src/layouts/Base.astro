---
import '@fontsource/poppins/400.css';
import '@fontsource/poppins/400-italic.css';
import '@fontsource/poppins/500.css';
import '../styles/global.css';
import '../styles/dark.css';
import site from '../data/site.json';
import { url, isExternal } from '../lib.js';

const { title, description = site.description, current = '', noindex = false } = Astro.props;
const pageTitle = title ? `${title} – ${site.name}` : site.homeTitle;
const canonical = new URL(Astro.url.pathname, Astro.site);
const ext = (href) => (isExternal(href) ? { target: '_blank', rel: 'noopener' } : {});
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <link rel="sitemap" href={url('/sitemap-index.xml')} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(url(site.hero.image), Astro.site)} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@devoxxgr" />
    <link rel="icon" sizes="32x32" href={url('/images/favicon-32.png')} />
    <link rel="icon" sizes="192x192" href={url('/images/favicon-192.png')} />
    <link rel="apple-touch-icon" href={url('/images/apple-touch-icon.png')} />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    {site.announcement && (
      <div class="announcement">
        <span>{site.announcement.text}</span>
        <a href={url(site.announcement.href)} {...ext(site.announcement.href)}>{site.announcement.linkLabel}</a>
      </div>
    )}

    <header class="site-header">
      <div class="site-header-inner">
        <a class="site-logo" href={url('/')}><img src={url(site.logo)} alt="Devoxx Greece" width="175" height="54" /></a>
        <nav class="site-nav" id="site-nav" aria-label="Main menu">
          {site.menu.map((item) => (
            <a href={url(item.href)} class:list={{ current: item.label === current }} {...ext(item.href)}>{item.label}</a>
          ))}
        </nav>
        <a class="btn btn-gold header-cta" href={site.event.tickets} target="_blank" rel="noopener">Tickets</a>
        <button class="menu-toggle" type="button" aria-label="Menu" aria-expanded="false" aria-controls="site-nav">
          <span></span><span></span><span></span>
        </button>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container">
        <div class="footer-cols">
          <div class="footer-brand">
            <img src={url(site.logo)} alt="Devoxx Greece" width="175" height="54" />
            <p>{site.event.dates}<br />{site.event.venue}</p>
          </div>
          {site.footer.map((col) => (
            <div>
              <p class="footer-title">{col.title}</p>
              <ul>
                {col.links.map((l) => <li><a href={url(l.href)} {...ext(l.href)}>{l.label}</a></li>)}
              </ul>
            </div>
          ))}
        </div>
        <p class="footer-legal">{site.copyright}</p>
      </div>
    </footer>

    <script is:inline>
      (function () {
        var toggle = document.querySelector('.menu-toggle');
        var nav = document.getElementById('site-nav');
        function set(open) {
          nav.classList.toggle('is-open', open);
          toggle.setAttribute('aria-expanded', String(open));
        }
        toggle.addEventListener('click', function () { set(!nav.classList.contains('is-open')); });
        nav.addEventListener('click', function (e) { if (e.target.closest('a')) set(false); });
        document.addEventListener('keydown', function (e) { if (e.key === 'Escape') set(false); });
      })();
    </script>

    <!-- Metricool analytics -->
    <script is:inline>function loadScript(a){var b=document.getElementsByTagName("head")[0],c=document.createElement("script");c.type="text/javascript",c.src="https://tracker.metricool.com/resources/be.js",c.onreadystatechange=a,c.onload=a,b.appendChild(c)}loadScript(function(){beTracker.t({hash:"1563c9c4aec5573a819ef7f6ae2d93f7"})});</script>
  </body>
</html>
